# ─────────────────────────────────────────────────────────────
# LifeOS AI — Environment
# Copy to .env.local and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres (direct, for migrations / edge)
DATABASE_URL=

# Redis (Upstash) — rate limiting, job queue, caching
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI — assistant + Second Brain (OpenAI-compatible providers)
# Pick a provider and set its key. Groq is the default.
AI_PROVIDER=groq                 # groq | cerebras
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# OpenAI — optional (onboarding intelligence)
OPENAI_API_KEY=

# ── Notion ───────────────────────────────────────────────────────────
# Option A — INTERNAL integration (fastest; builds into your own workspace).
#   1. https://www.notion.so/my-integrations → New integration → Internal
#   2. Copy the "Internal Integration Secret" into NOTION_TOKEN
#   3. Create/pick a Notion page, then ••• → Connections → add your integration
#   4. Paste that page's URL (or id) into NOTION_ROOT_PAGE_ID
NOTION_TOKEN=
NOTION_ROOT_PAGE_ID=

# Option B — PUBLIC OAuth integration (multi-user, what ships to customers).
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/integrations/notion/callback

# Stripe — billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_FOUNDER=price_...

# Integrations (OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
