# LifeOS agent — the server's settings, written by install.sh to
# /opt/lifeos-agent/.env (owner-only). You normally never edit this by hand:
#   lifeos-agent token    a new LifeOS token
#   lifeos-agent config   another model provider, model or key
#
# This file must NEVER contain database, Notion or Supabase credentials.
# The agent is deliberately powerless on its own.

# Where LifeOS is reachable (https in production).
LIFEOS_URL=https://your-lifeos.example.com

# Scoped, revocable token from LifeOS → Agent → Install on a server.
# Revoking it in LifeOS stops the agent at once.
LIFEOS_AGENT_TOKEN=lifeos_agent_...

# Model provider (OpenAI-compatible, JSON mode required). Groq's free tier by default.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL=qwen/qwen3.8-27b

# Alternatives — same shape, swap the two lines above:
#   Mistral    MODEL_BASE_URL=https://api.mistral.ai/v1      MODEL=mistral-small-latest
#   OpenRouter MODEL_BASE_URL=https://openrouter.ai/api/v1   MODEL=<a model id from openrouter.ai/models>

# Polling: every POLL_MS when idle, HOT_POLL_MS while a conversation is live.
POLL_MS=10000
HOT_POLL_MS=1500
# The background pass. Not lower: it spends the daily action quota.
AUTONOMOUS_MS=900000
