# LifeOS Agent Runner — VPS environment.
#
# This file must NEVER contain database, Notion or Supabase credentials.
# The runner is deliberately powerless on its own.

# Where LifeOS is reachable (must be HTTPS in production).
LIFEOS_URL=https://your-app.vercel.app

# Scoped, revocable token minted in LifeOS → Settings → Agent.
# Revoking it in the UI stops the runner instantly.
LIFEOS_AGENT_TOKEN=lifeos_agent_...

# Model provider (OpenAI-compatible). Groq free tier by default.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL=qwen/qwen3.8-27b

# Alternatives — same shape, just swap the two lines above:
#   Cerebras   MODEL_BASE_URL=https://api.cerebras.ai/v1        MODEL=llama-3.3-70b
#   OpenRouter MODEL_BASE_URL=https://openrouter.ai/api/v1      MODEL=meta-llama/llama-3.3-70b-instruct:free

# How often to wake up, in milliseconds.
POLL_MS=30000
